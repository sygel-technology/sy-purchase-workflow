<odoo>
    <record id="view_purchase_order_form_inherit_custom" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.custom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
            <button name="action_confirm_create_picking_force"
                    string="Create Manual Receipt"
                    type="object"
                    confirm="Are you sure you want to create the warehouse receipt for this purchase?"
                    attrs="{'invisible': [
                        ('split_status', '=', 'children'),
                    ]}"
                    class="btn-primary"
                    icon="fa-truck"/>
            </xpath>
        </field>
    </record>

</odoo>
