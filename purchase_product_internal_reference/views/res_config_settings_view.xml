<odoo>
    <record
        id="purchase_internal_product_reference_res_config_settings_view_form"
        model="ir.ui.view"
    >
        <field name="name">
            purchase.internal.product.reference.res.config.settings.view.form
        </field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase.res_config_settings_view_form_purchase"
        />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='matrix_setting_container']" position="inside">
                <setting
                    id="internal_ref_product_setting"
                    string="Show internal product reference"
                    help="Show the internal product reference on purchases. The default is the supplier's reference."
                >
                    <field name="internal_ref_product" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
